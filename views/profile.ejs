<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        h1{
            text-align: center;
        }
        h1::first-letter{
            color: red;
            font-weight: 900;
            font-size: 40px;
            font-style: cursive;
        }
        .child{
            width: 260px;
            height: 260px;
            border: 2px solid red;
            
            position: relative;
            border-radius: 30px;
            overflow: hidden;

        }
        .mainProfileImg{
            width: 100%;
            height: 100%;
            object-fit:cover;
        }
        .child:hover .viewUser{
            background: rgba(0,0,0,0.4);
            
        }
        .container{
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-items: center;
            gap: 10px;
            width: 100%;
            
        }
        .viewUser{
            color: rgba(255,255,255,0);
            position: absolute;
            inset: 0;
            transition:0.5s;
        }
        .viewUser button{
            color: rgba(255,255,255,0);
        }
        .child:hover .viewUser p::first-letter{
            color: Gold;
            /* text-transform: uppercase; */
        }
        .child:hover .viewUser,button{
            color: rgba(255,255,255,1);
        }
        .viewUser{
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }
        .viewUser p{
            font-size: 20px;
        }
        .viewUser button{
            height: 20px;
            border: none;
            border-radius: 14px;
            /* background: rgba(255,255,255,0.4); */
            /* color:rgba(0,0,0,1); */
            
        }
        a{
            text-decoration: none;
        }
        .viewUser{
            opacity: 0;
        }
        .child:hover .viewUser{
            opacity: 1;
        }
        .create{
            color: white;
            margin-bottom: 30px;
            margin-left:40px;
            border: none;
            background: black;
            padding: 10px;
            border-radius: 30px;

        }
        .create a{
            text-decoration: none;
            color: white;
        }

    </style>
</head>
<body>
    <h1>Instagram</h1>
    <button class="create"> <a href="/profile/create">Create New Profile</a> </button>
    <div class="container">
        <%for(let i of data){%>
            <div class="child">
                <img src=<%= i.profileImageUrl %> alt="Error loading image" class="mainProfileImg">
                <!-- <span><%= i.id %></span> -->
                <div class="viewUser">
                    <p>@<%= i.username %></p>
                    <button><a href="/profile/<%= i.id%>">View Profile</a></button>
                </div>
            </div>
            <%}%>
    </div>
</body>
</html>